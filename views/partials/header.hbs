<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <nav class="nav-pill pointer-events-auto hidden md:flex" aria-label="Primary">
    {{#each nav}}
      <a
        href="{{href}}"
        class="{{#if (eq ../page id)}}is-active{{/if}}"
        {{#if (eq ../page id)}}aria-current="page"{{/if}}
      >{{label}}</a>
    {{/each}}
    <a href="{{resume}}" class="nav-resume" download>Résumé</a>
  </nav>

  <div class="pointer-events-auto flex items-center justify-between px-5 py-4 md:hidden">
    <a href="index.html" class="font-display text-xl font-extrabold uppercase tracking-tight text-white drop-shadow">TM</a>
    <button
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/25 bg-void/50 text-white backdrop-blur-md"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <span class="flex flex-col gap-1.5" aria-hidden="true">
        <span class="block h-0.5 w-4 bg-current"></span>
        <span class="block h-0.5 w-4 bg-current"></span>
        <span class="block h-0.5 w-3 bg-current"></span>
      </span>
    </button>
  </div>

  <div id="mobile-nav" class="mobile-nav" data-nav-panel>
    <div class="flex h-full flex-col px-6 pb-10 pt-24">
      <nav class="flex flex-col gap-6" aria-label="Mobile">
        {{#each nav}}
          <a href="{{href}}" class="font-display text-5xl font-extrabold uppercase tracking-tight text-ink">{{label}}</a>
        {{/each}}
      </nav>
      <a href="{{resume}}" class="btn btn-beam mt-auto w-fit" download>Download résumé</a>
    </div>
  </div>
</header>
