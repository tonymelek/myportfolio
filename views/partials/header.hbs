<a href="#main" class="skip-link">Skip to main content</a>

<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <nav class="nav-pill pointer-events-auto hidden md:flex" aria-label="Primary">
    {{#each nav}}
      <a
        href="{{href}}"
        class="{{#if (eq ../page id)}}is-active{{/if}}"
        {{#if (eq ../page id)}}aria-current="page"{{/if}}
      >{{label}}</a>
    {{/each}}
    <a href="{{resume}}" class="nav-resume" download>Résumé</a>
  </nav>

  <div
    class="mobile-chrome pointer-events-auto relative z-50 flex items-center justify-between px-5 py-3 md:hidden{{#if (eq page "home")}} is-over-hero{{/if}}"
    data-mobile-chrome
  >
    <a href="{{homeHref}}" class="mobile-chrome-brand font-display text-xl font-extrabold uppercase tracking-tight">TM</a>
    <button
      type="button"
      class="mobile-chrome-toggle inline-flex h-11 w-11 items-center justify-center rounded-full border backdrop-blur-md"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <span class="menu-icon" aria-hidden="true">
        <span class="menu-icon-line"></span>
        <span class="menu-icon-line"></span>
        <span class="menu-icon-line"></span>
      </span>
    </button>
  </div>

  <div id="mobile-nav" class="mobile-nav" data-nav-panel hidden>
    <div class="flex h-full flex-col px-6 pb-10 pt-24">
      <nav class="flex flex-col gap-6" aria-label="Mobile">
        {{#each nav}}
          <a href="{{href}}" class="font-display text-5xl font-extrabold uppercase tracking-tight text-ink">{{label}}</a>
        {{/each}}
      </nav>
      <a href="{{resume}}" class="btn btn-beam mt-auto w-fit" download>Download résumé</a>
    </div>
  </div>
</header>
